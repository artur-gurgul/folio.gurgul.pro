//- The page and its frame.
//-
//- A page carries its OWN content and nothing else, inside <noscript id="page">:
//- with JavaScript off that is simply the page (and what a crawler that runs no
//- script reads). With JavaScript on, a browser keeps a <noscript>'s inside as
//- raw text, so the script right below turns that text into the page — before
//- anything is fetched — inside the frame from <template id="frame">: the side
//- panel's fixed part (sidebar.pug) beside it. static/js/site.js then fills the
//- panel from nav.json. The <noscript> and the <template> are REPLACED, not
//- copied, so nothing is in the document twice.
//-
//- Use: `include frame.pug`, then `+frame` with the content as its block.
mixin frame()
  template#frame
    .container
      .sidebar
        include sidebar.pug
      .scroll
  noscript#page
    block
  script.
    (function () {
      var page = document.getElementById("page")
      var frame = document.getElementById("frame")
      if (!page) return
      var shell = frame && frame.content && frame.content.firstElementChild
      var into = document.createElement("div")
      if (shell) {
        shell = document.importNode(shell, true)
        into = shell.querySelector(".scroll")
        // on a phone the panel sits above the content: folded, so it adds one line
        if (window.matchMedia && matchMedia("(max-width: 860px)").matches) {
          shell.querySelectorAll("details.contents").forEach(function (d) { d.open = false })
        }
      }
      into.innerHTML = page.textContent
      page.parentNode.replaceChild(shell || into, page)
      if (frame) frame.parentNode.removeChild(frame)
    })()
