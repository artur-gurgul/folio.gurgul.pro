//- memos.pug — the list of folios (.tex pages), grouped by area.
//-
//- The list is the page's CONTENT, so it is in the HTML, in plain <main>: every
//- folio with its title and one-liner, readable with JavaScript off and by a
//- crawler.
//- What only serves the filter is not in the HTML: static/js/memos.js reads it
//- from the index Sajt writes at build (context.memos.index) — each folio's
//- area, labels and tags (the tag links under each folio come from there) — and
//- the text (context.memos.search) when the search box is used. The filter
//- itself is the side panel (site.js builds it from nav.json); memos.js takes it
//- over and filters the list in place, keeping the state in the URL
//- (?area=swift&tag=actors) so a filter is shareable.
//-
//- Use: a page with `layout: memos` (its own text goes above the list).
-
  const sheets = context.sheets || []
  const areas = []
  for (const s of sheets) {
    let a = areas.find(x => x.key === s.area)
    if (!a) { a = { key: s.area, sheets: [] }; areas.push(a) }
    a.sheets.push(s)
  }
  areas.sort((x, y) => x.key.localeCompare(y.key))
  for (const a of areas) a.sheets.sort((x, y) => x.title.localeCompare(y.title))
  const description = page.file.data.description || "folio — one subject, one A4 page: dense facts and visualisations to remember it by"
doctype html
html(lang="en")
  head
    include head.pug
    script(src="/static/js/memos.js" defer)
  body(data-nav=context.generate && context.generate.nav)
    main.content
      h1.title= page.title
      #post
        != page.file.html
        .memos(data-index=context.memos.index data-search=context.memos.search data-list=context.memos.list)
          p.memos-status
            span.memos-count #{sheets.length} #{sheets.length === 1 ? "folio" : "folios"}
            span.memos-active
          //- id: the front page's site map links to each area (#area-<key>)
          each a in areas
            section.memos-area(id="area-" + a.key data-area=a.key)
              h2= a.key
              ul.memos-list
                each s in a.sheets
                  li
                    a.memos-title(href=s.url)= s.title
                    if s.oneliner
                      p.memos-oneliner= s.oneliner
      .footer
        include footer.pug
