//- cv.pug — a CV page from a YAML file (`layout: cv`, data under `cv:`).
//-
//- Keys: name, headline, contact[{kind,text,href}], profile, skills[{group,items}],
//- education[{degree,school,field}], languages[{name,level}],
//- experience[{role,company,location,start,end,summary,used,projects[{name,summary,used}]}],
//- consent. Dates are "YYYY-MM"; end may be "present".
-
  const cv = page.file.data.cv || {}
  const MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"]
  const when = (d) => {
    if (d === undefined || d === null || d === "") return ""
    if (String(d).toLowerCase() === "present") return "Present"
    const [y, m] = String(d).split("-")
    return m ? `${MONTHS[Number(m) - 1]} ${y}` : y
  }
  const used = (list) => (list || []).join(" · ")
doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title #{cv.name} — #{cv.headline}
    meta(name="author" content=cv.name)
    meta(name="theme-color" content="#0a5fd6")
    link(rel="icon" href="/static/favicon.svg" type="image/svg+xml")
    link(rel="stylesheet" href="/static/css/all.css")
    link(rel="stylesheet" href="/static/css/cv.css")
  body.cv-page
    main.cv
      aside.cv-side
        ul.cv-contact
          each c in cv.contact || []
            li(class=`cv-contact-${c.kind}`)
              if c.href
                a(href=c.href)= c.text
              else
                span= c.text

        if cv.skills
          section.cv-block
            h2 Skills
            each s in cv.skills
              h3= s.group
              p.cv-list= s.items.join(" · ")

        if cv.education
          section.cv-block
            h2 Education
            each e in cv.education
              p.cv-edu
                strong= e.degree
                br
                | #{e.school}
                br
                | #{e.field}

        if cv.languages
          section.cv-block
            h2 Languages
            each l in cv.languages
              p.cv-lang
                strong= l.name
                |  — #{l.level}

      div.cv-main
        //- `pdf:` at the top level of the YAML: a URL to a PDF of this CV,
        //- produced by the site's build (Sajt does not generate it).
        if page.file.data.pdf
          //- icon only (owner, 2026-09-24); the words live in the tooltip and
          //- the accessible name
          a.cv-download(href=page.file.data.pdf, download="", title="Download PDF", aria-label="Download PDF")
            svg(viewBox="0 0 16 16" width="18" height="18" aria-hidden="true")
              path(d="M8 1v9m0 0L4.5 6.5M8 10l3.5-3.5M2 12.5V14h12v-1.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
        header.cv-head
          h1= cv.name
          p.cv-headline= cv.headline

        if cv.profile
          section.cv-section
            h2 Profile
            p= cv.profile

        if cv.experience
          section.cv-section
            h2 Experience
            each job in cv.experience
              article.cv-job
                div.cv-job-top
                  h3= job.role
                  span.cv-dates #{when(job.start)} — #{when(job.end)}
                p.cv-org
                  span.cv-company= job.company
                  if job.location
                    |  · #{job.location}
                if job.summary
                  p= job.summary
                each p in job.projects || []
                  div.cv-project
                    h4 › #{p.name}
                    p= p.summary
                    if p.used
                      p.cv-used
                        span USED
                        | #{used(p.used)}
                if job.used
                  p.cv-used
                    span USED
                    | #{used(job.used)}

        if cv.consent
          footer.cv-consent= cv.consent
